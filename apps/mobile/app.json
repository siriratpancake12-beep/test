{
  "expo": {
    "name": "语途",
    "description": "语途是面向 14 岁以上中文学习者的外语学习 App,首发英语、法语、德语:按你的目标定制学习计划,在快忘的时候安排复习,针对常犯的错误专项练习,每周报告让进步看得见。",
    "slug": "lingo-cn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.lingocn",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#435BE9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.example.lingocn"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "lingocn",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-audio",
        {
          "microphonePermission": "跟读练习时录下你的发音,和标准发音对比。录音只在本机或用于打分,不会公开。"
        }
      ],
      "expo-apple-authentication",
      "expo-secure-store",
      "expo-iap"
    ],
    "extra": {
      "apiBase": ""
    }
  }
}
