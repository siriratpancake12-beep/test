{
  "expo": {
    "name": "语途",
    "description": "语途是面向 14 岁以上中文学习者的外语学习 App,首发英语、法语、德语:按你的目标定制学习计划,在快忘的时候安排复习,针对常犯的错误专项练习,每周报告让进步看得见。",
    "slug": "lingo-cn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.lingocn",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#435BE9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.example.lingocn",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "lingocn",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#3355FF",
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "跟读时录下你的发音,用来和标准发音对比、打分;评分后立即删除,不会保存或公开。",
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-apple-authentication",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-iap"
    ],
    "extra": {
      "apiBase": "",
      "icpRecord": ""
    }
  }
}
