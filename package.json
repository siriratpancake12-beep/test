{
  "name": "lingo-cn",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm test -w @lingo/core",
    "typecheck": "npm run typecheck -w @lingo/core && npm run typecheck -w @lingo/mobile",
    "validate": "tsx tools/validate-content.ts",
    "content:index": "tsx tools/gen-content-index.ts",
    "e2e": "npm run build:web -w @lingo/mobile && tsx tests/e2e/run.ts"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "playwright": "1.64.1"
  }
}
