{
  "name": "lingo-cn",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "validate": "tsx tools/validate-content.ts",
    "content:index": "tsx tools/gen-content-index.ts",
    "content:bench": "tsx tools/bench-content.ts",
    "e2e": "npm run build:web -w @lingo/mobile && tsx tests/e2e/run.ts",
    "content:hours": "tsx tools/course-hours.ts",
    "content:sync-order": "tsx tools/sync-order.ts",
    "content:dedupe": "tsx tools/dedupe-outline.ts"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "playwright": "1.64.1"
  }
}
