  "grammar": [
    { "id": "fr.g.nationality", "titleZh": "国籍形容词分阴阳性",
      "bodyZh": "说自己的国籍,男生和女生用的词不同:阴性一般在阳性后面加 e。加了 e 以后,原来不发音的词尾辅音要读出来:chinois [ʃi.nwa] → chinoise [ʃi.nwaz]。中文“中国人”、英语 Chinese 都不分男女,法语要分,这是中国学生最容易忘的地方。另外,法语的国籍形容词首字母小写(英语 Chinese 要大写)。",
      "examples": [ { "text": "Je suis chinois.", "zh": "我是中国人。(男生说)" }, { "text": "Je suis chinoise.", "zh": "我是中国人。(女生说,s 读 [z])" } ] },
    { "id": "fr.g.je_mappelle", "titleZh": "Je m'appelle… / Je suis…:先整句记",
      "bodyZh": "介绍自己有两种说法:Je m'appelle + 名字(我叫……),Je suis + 名字或国籍(我是……)。现在先把它们当成整句记住,不用拆开分析(je 和 être 第 4 课再学)。注意 Je suis 后面直接接国籍,不加冠词,这一点和英语 I am Chinese 一样。打招呼:Bonjour 对谁都可以说;Salut 只对朋友、同学说,见面和告别都能用。",
      "examples": [ { "text": "Je m'appelle Hao.", "zh": "我叫浩。" }, { "text": "Je suis Hao.", "zh": "我是浩。" }, { "text": "Salut, Chloé !", "zh": "嗨,克洛艾!(朋友之间)" } ] }
  ],
