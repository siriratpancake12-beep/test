    { "id": "fr.salut", "kind": "word", "pos": "interj", "text": "Salut", "zh": "嗨(朋友之间)", "features": { "ipa": "sa.ly" }, "noteZh": "朋友、同学之间说,见面和告别都能用;对老师、店员要说 Bonjour。词尾 t 不发音,u 读 [y](嘴唇撮圆,像汉语“鱼”的韵母)。" },
    { "id": "fr.je_mappelle", "kind": "phrase", "pos": "phrase", "text": "Je m'appelle", "zh": "我叫……", "features": { "ipa": "ʒə ma.pɛl" }, "noteZh": "m' 是 me 的省音,和 appelle 连着读 [ma.pɛl];双 l 只读一个 [l],词尾 e 不发音。后面直接接名字:Je m'appelle Hao." },
    { "id": "fr.je_suis", "kind": "phrase", "pos": "phrase", "text": "Je suis", "zh": "我是……", "features": { "ipa": "ʒə sɥi" }, "noteZh": "后面直接接名字或国籍:Je suis Hao. / Je suis chinois.;suis 的 s 不发音,ui 读 [ɥi]。" },
