  "lines": [
    { "speaker": "vendor", "text": "학생, 사과 싸요! 진짜 맛있어요!", "zh": "(星期六上午,陈静和秀雅逛传统市场,水果摊的阿姨吆喝)同学,苹果便宜啦!可好吃了!", "roman": "haksaeng, sagwa ssayo! jinjja masisseoyo!", "items": ["ko.haksaeng", "ko.sagwa", "ko.ssayo", "ko.jinjja", "ko.masisseoyo"] },
    { "speaker": "jing", "text": "사과 얼마예요?", "zh": "苹果多少钱?", "roman": "sagwa eolmayeyo?", "items": ["ko.sagwa", "ko.eolmayeyo"] },
    { "speaker": "vendor", "text": "한 개에 천 원이에요.", "zh": "一个一千韩元。", "roman": "han gaee cheon wonieyo.", "items": ["ko.hana", "ko.gae", "ko.cheon", "ko.won"] },
    { "speaker": "sua", "text": "징 씨, 시장 과일은 싸요. 편의점은 비싸요.", "zh": "陈静,市场的水果便宜,便利店的贵。", "roman": "jing ssi, sijang gwaireun ssayo. pyeonuijeomeun bissayo.", "items": ["ko.ssi", "ko.sijang", "ko.gwail", "ko.ssayo", "ko.pyeonuijeom", "ko.bissayo"] },
    { "speaker": "jing", "text": "그럼 다섯 개 주세요. 다 얼마예요?", "zh": "那给我五个。一共多少钱?", "roman": "geureom daseot gae juseyo. da eolmayeyo?", "items": ["ko.geureom", "ko.daseot", "ko.gae", "ko.juseyo", "ko.da", "ko.eolmayeyo"] },
    { "speaker": "vendor", "text": "오천 원이에요.", "zh": "五千韩元。", "roman": "ocheon wonieyo.", "items": ["ko.o", "ko.cheon", "ko.won"] },
    { "speaker": "jing", "text": "사장님, 조금 깎아 주세요!", "zh": "老板,便宜一点吧!", "roman": "sajangnim, jogeum kkakka juseyo!", "items": ["ko.sajangnim", "ko.jogeum", "ko.kkakka_juseyo"] },
    { "speaker": "vendor", "text": "그럼 사천오백 원!", "zh": "(阿姨笑了)那就四千五!", "roman": "geureom sacheonobaek won!", "items": ["ko.geureom", "ko.sa", "ko.cheon", "ko.o", "ko.baek", "ko.won"] },
    { "speaker": "jing", "text": "감사합니다! 그리고 저거는 얼마예요?", "zh": "谢谢!还有,那个多少钱?(她指着一盒草莓)", "roman": "gamsahamnida! geurigo jeogeoneun eolmayeyo?", "items": ["ko.gamsahamnida", "ko.geurigo", "ko.jeogeo", "ko.eolmayeyo"] },
    { "speaker": "vendor", "text": "이거요? 만 원이에요.", "zh": "这个?一万韩元。", "roman": "igeoyo? man wonieyo.", "items": ["ko.igeo", "ko.man", "ko.won"] },
    { "speaker": "jing", "text": "만 원이요? 너무 비싸요!", "zh": "一万?太贵了!", "roman": "man woniyo? neomu bissayo!", "items": ["ko.man", "ko.won", "ko.neomu", "ko.bissayo"] },
    { "speaker": "sua", "text": "괜찮아요. 사과도 진짜 맛있어요!", "zh": "没事,苹果也特别好吃!", "roman": "gwaenchanayo. sagwado jinjja masisseoyo!", "items": ["ko.gwaenchanayo", "ko.sagwa", "ko.jinjja", "ko.masisseoyo"] }
