  "lines": [
    { "speaker": "jing", "text": "수아 씨, 오늘이 무슨 요일이에요?", "zh": "(星期天晚上,宿舍里,两人在对下周的安排)秀雅,今天星期几?", "roman": "sua ssi, oneuri museun yoirieyo?", "items": ["ko.ssi", "ko.oneul", "ko.museun"] },
    { "speaker": "sua", "text": "일요일이에요! 내일은 월요일이에요.", "zh": "(秀雅笑了)星期天啊!明天就星期一了。", "roman": "iryoirieyo! naeireun woryoirieyo.", "items": ["ko.iryoil", "ko.naeil", "ko.woryoil"] },
    { "speaker": "sua", "text": "징 씨는 무슨 요일에 아르바이트해요?", "zh": "你星期几打工?", "roman": "jing ssineun museun yoire areubaiteuhaeyo?", "items": ["ko.ssi", "ko.museun", "ko.areubaiteu", "ko.haeyo"] },
    { "speaker": "jing", "text": "월요일하고 수요일에 아르바이트해요.", "zh": "星期一和星期三打工。", "roman": "woryoilhago suyoire areubaiteuhaeyo.", "items": ["ko.woryoil", "ko.suyoil", "ko.areubaiteu", "ko.haeyo"] },
    { "speaker": "sua", "text": "화요일하고 목요일에는요?", "zh": "那星期二和星期四呢?", "roman": "hwayoilhago mogyoireneunyo?", "items": ["ko.hwayoil", "ko.mogyoil"] },
    { "speaker": "jing", "text": "오전에는 수업이 있어요. 오후에는 도서관에서 공부해요.", "zh": "上午有课,下午在图书馆学习。", "roman": "ojeoneneun sueobi isseoyo. ohueneun doseogwaneseo gongbuhaeyo.", "items": ["ko.ojeon", "ko.sueop", "ko.isseoyo", "ko.ohu", "ko.doseogwan", "ko.gongbuhaeyo"] },
    { "speaker": "sua", "text": "저는 금요일에 시험이 있어요.", "zh": "我星期五有考试。", "roman": "jeoneun geumyoire siheomi isseoyo.", "items": ["ko.jeo", "ko.geumyoil", "ko.siheom", "ko.isseoyo"] },
    { "speaker": "jing", "text": "무슨 시험이에요?", "zh": "什么考试?", "roman": "museun siheomieyo?", "items": ["ko.museun", "ko.siheom"] },
    { "speaker": "sua", "text": "전공 시험이에요.", "zh": "专业课考试。", "roman": "jeongong siheomieyo.", "items": ["ko.jeongong", "ko.siheom"] },
    { "speaker": "jing", "text": "그럼 주말에 뭐 해요?", "zh": "那周末做什么?", "roman": "geureom jumare mwo haeyo?", "items": ["ko.geureom", "ko.jumal", "ko.mwo", "ko.haeyo"] },
    { "speaker": "sua", "text": "토요일에 같이 부산에 가요! 제 고향이에요.", "zh": "星期六一起去釜山吧!那是我老家。", "roman": "toyoire gachi busane gayo! je gohyangieyo.", "items": ["ko.toyoil", "ko.gachi", "ko.gayo", "ko.gohyang"] },
    { "speaker": "jing", "text": "좋아요! 부산은 처음이에요.", "zh": "好啊!我还是第一次去釜山。", "roman": "joayo! busaneun cheoeumieyo.", "items": ["ko.joayo", "ko.cheoeum"] }
