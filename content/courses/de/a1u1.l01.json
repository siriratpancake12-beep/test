  "grammar": [
    { "id": "de.g.ich_verb", "titleZh": "动词跟着“我”变:ich + 动词-e",
      "bodyZh": "德语动词要随人称变化,不像中文“我叫、你叫、他叫”都一样。和 ich(我)搭配时,动词一般以 -e 结尾:heißen → ich heiße,kommen → ich komme。动词紧跟在 ich 后面,名字、国家、城市直接放在最后:Ich heiße Wei. / Ich komme aus China.。别受英语 I am … 的影响说成 ✗ Ich bin heiße Wei——德语里“叫”就是 heiße 一个词。",
      "examples": [ { "text": "Ich heiße Wei.", "zh": "我叫王伟。" }, { "text": "Ich komme aus China.", "zh": "我来自中国。" }, { "text": "Ich komme aus Berlin.", "zh": "我来自柏林。" } ] },
    { "id": "de.g.hallo_guten_tag", "titleZh": "Hallo 还是 Guten Tag?",
      "bodyZh": "德语打招呼要看对象:朋友、同学、年轻人之间说 Hallo(随意);对陌生人、长辈、老师、店员说 Guten Tag(正式,白天用)。中文的“你好”两种场合都能用,德语要分开。在大学里,学生之间一见面就说 Hallo。王伟开口说 Guten Tag 没有错,只是有点正式;莉娜说 Hallo,他马上也改说 Hallo。告别也分两种:朋友之间 Tschüss,正式场合 Auf Wiedersehen(本单元复习课学)。",
      "examples": [ { "text": "Hallo, Lena!", "zh": "你好,莉娜!" }, { "text": "Guten Tag!", "zh": "您好!" } ] }
  ],
