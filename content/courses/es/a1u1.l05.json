  "lines": [
    { "speaker": "diego", "text": "Li Na, ¿cuántos años tienes? ¿Dieciocho?", "zh": "李娜,你多大了?十八?", "items": ["es.cuantos_anos_tienes", "es.dieciocho"] },
    { "speaker": "lina", "text": "No, no. Tengo veinte años. ¿Y tú?", "zh": "不对,不对。我二十岁。你呢?", "items": ["es.no", "es.cuantos_anos_tienes", "es.veinte", "es.y", "es.tu"] },
    { "speaker": "diego", "text": "Veinte. ¿Y Javier? ¿Cuántos años tiene?", "zh": "二十。那哈维尔呢?他多大?", "items": ["es.veinte", "es.y", "es.cuantos_anos_tienes"] },
    { "speaker": "javier", "text": "¿Yo? ¿Cuántos años tengo?", "zh": "我?猜猜我多大?", "items": ["es.yo", "es.cuantos_anos_tienes"] },
    { "speaker": "diego", "text": "¿Once? ¿Doce? ¿Trece?", "zh": "十一?十二?十三?", "items": ["es.once", "es.doce", "es.trece"] },
    { "speaker": "lina", "text": "¿Catorce? ¿Quince? ¿Dieciséis? ¿Diecisiete?", "zh": "十四?十五?十六?十七?", "items": ["es.catorce", "es.quince", "es.dieciseis", "es.diecisiete"] },
    { "speaker": "javier", "text": "¡No, no! Tengo diecinueve años.", "zh": "不对不对!我十九岁。", "items": ["es.no", "es.cuantos_anos_tienes", "es.diecinueve"] },
    { "speaker": "diego", "text": "¿Diecinueve? ¡Y Li Na y yo, veinte!", "zh": "十九?我和李娜都二十!", "items": ["es.diecinueve", "es.y", "es.yo", "es.veinte"] }
  ],
  "questions": [
